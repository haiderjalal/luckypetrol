# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Shop sign-in (internal system at /shop)
SHOP_USERNAME=
SHOP_PASSWORD=
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOP_SESSION_SECRET=
# Public address of the website. Customer share links and WhatsApp messages use it.
SHOP_PUBLIC_URL=http://localhost:3000

# Optional. Where the SQLite database is stored. Default: data/shop.sqlite
# SHOP_DB_PATH=
